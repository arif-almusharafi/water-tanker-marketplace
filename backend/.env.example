# Copy this file to backend/.env (the app, alembic, and the scripts load it), or set
# real environment variables (they win over the file). Example values only.

# Local: leave empty to use sqlite:///./local.db
# Production (PostgreSQL):
DATABASE_URL=postgresql+psycopg://mooyah_user:change-me@db.example.com:5432/mooyah

# Frontend addresses allowed to call the API (comma list).
CORS_ORIGINS=http://127.0.0.1:5200,http://localhost:5200
